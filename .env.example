# MCPServer settings reference.
#
# ASP.NET Core does not load this file. It documents the settings the server reads:
#   - Locally, set them with user secrets from src/MCPServer, for example:
#       dotnet user-secrets set "Authentication:Authority" "https://login.microsoftonline.com/<tenant-id>/v2.0"
#       dotnet user-secrets set "Authentication:Audiences:0" "<api-client-id>"
#   - In Azure App Service, add them as application settings using the names below.
# Never commit real values.

# --- Hosting -----------------------------------------------------------------
# URL the server listens on. Azure App Service sets this itself.
ASPNETCORE_URLS=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development

# Required on Azure App Service (Linux): TLS ends at the platform, so the server must trust
# the forwarded scheme to publish an https:// sign-in metadata URL.
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# --- Sign-in (required) --------------------------------------------------------
# OpenID Connect issuer whose tokens are accepted. For Microsoft Entra ID use the
# single-tenant v2.0 endpoint and set the API app registration to issue v2 access tokens
# (manifest: "requestedAccessTokenVersion": 2).
Authentication__Authority=https://login.microsoftonline.com/01a46e9c-3fa4-4359-8466-ecf0acf053a8/v2.0

# Accepted token audiences ("aud"). For Entra ID v2 tokens this is the API app
# registration's client ID. Add more with __1, __2, ...
Authentication__Audiences__0=65e1d4aa-c5d0-4441-bec3-a9a450700b93

# Delegated scopes. They are advertised to MCP clients and one of them must be present
# in the token of a signed-in user. Use the full form clients request.
Authentication__Scopes__0=api://65e1d4aa-c5d0-4441-bec3-a9a450700b93/mcp.access

# Application roles accepted for callers without a signed-in user (for example a managed
# identity). Optional.
# Authentication__Roles__0=Mcp.Tools.Invoke

# If neither a scope nor a role is configured, any valid token for the audience is accepted.

# --- Telemetry (optional) ------------------------------------------------------
# Unset: console logging only.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
